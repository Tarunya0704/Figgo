# =============================================================================
# FIGGO PRO - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# User tokens are NOT needed here - they come from OAuth flows!

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql://user:password@host:5432/database"

# =============================================================================
# NEXTAUTH (App Authentication)
# =============================================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# =============================================================================
# FIGMA OAUTH APP
# Create at: https://www.figma.com/developers/apps
# =============================================================================
FIGMA_CLIENT_ID="your-figma-client-id"
FIGMA_CLIENT_SECRET="your-figma-client-secret"
FIGMA_REDIRECT_URI="http://localhost:3000/api/auth/figma/callback"

# =============================================================================
# GITHUB OAUTH APP
# Create at: https://github.com/settings/developers
# =============================================================================
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_REDIRECT_URI="http://localhost:3000/api/integrations/github/callback"

# =============================================================================
# VERCEL OAUTH INTEGRATION
# Create at: https://vercel.com/account/integrations
# =============================================================================
VERCEL_CLIENT_ID="your-vercel-client-id"
VERCEL_CLIENT_SECRET="your-vercel-client-secret"
VERCEL_REDIRECT_URI="http://localhost:3000/api/integrations/vercel/callback"

# =============================================================================
# AI (Groq for code generation)
# Get key at: https://console.groq.com
# =============================================================================
GROQ_API_KEY="your-groq-api-key"

# =============================================================================
# OPTIONAL: Google OAuth (for login)
# Create at: https://console.cloud.google.com/apis/credentials
# =============================================================================
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
